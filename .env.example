# Copy to .env (gitignored) and fill in. Only the keys for providers you use are needed.
DEEPSEEK_API_KEY=

# The database password, used by docker compose and by local runs (required; pick a long random one).
POSTGRES_PASSWORD=
# Optional: another database. Local runs otherwise use the compose one on 127.0.0.1:5433.
# DATABASE_URL=postgresql+psycopg://readlab:<password>@127.0.0.1:5433/readlab

# The app (defaults shown).
# READLAB_ADMIN_EMAIL=
# READLAB_ADMIN_PASSWORD=
# READLAB_WORD_QUOTA=30000
# READLAB_QUOTA_DAYS=30
# READLAB_USER_BUDGET_USD=1.00
# READLAB_WORKER_CONCURRENCY=2
# READLAB_COOKIE_SECURE=0
