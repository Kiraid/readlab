{
  "type": "object",
  "additionalProperties": false,
  "required": ["rows", "cols"],
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "intro": { "type": "string", "maxLength": 240 },
    "rows": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "maxLength": 24 }, "label": { "type": "string", "maxLength": 30 } } } },
    "cols": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "maxLength": 24 }, "label": { "type": "string", "maxLength": 30 } } } },
    "cells": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 }, "description": "'row/col' -> what that cell means" },
    "items": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["label", "row", "col"],
      "properties": { "label": { "type": "string", "maxLength": 30 }, "row": { "type": "string" }, "col": { "type": "string" },
        "text": { "type": "string", "maxLength": 300 }, "code": { "type": "string", "maxLength": 400 } } } }
  }
}
