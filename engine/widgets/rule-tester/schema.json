{
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "intro": { "type": "string", "maxLength": 240 },
    "input_label": { "type": "string", "maxLength": 30 },
    "placeholder": { "type": "string", "maxLength": 60 },
    "pick": { "enum": ["first", "longest", "all"] },
    "rules": { "type": "array", "minItems": 1, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "pattern"],
      "properties": {
        "kind": { "enum": ["exact", "prefix", "path-prefix", "glob", "regex", "host", "cidr", "any"] },
        "pattern": { "type": "string", "maxLength": 80 },
        "label": { "type": "string", "maxLength": 50 },
        "target": { "type": "string", "maxLength": 50, "description": "where a match sends the input" } } } },
    "presets": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 80 } },
    "notes": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 160 } },
    "no_match": { "type": "string", "maxLength": 160 }
  }
}
