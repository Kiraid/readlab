{
  "type": "object",
  "additionalProperties": false,
  "required": ["lanes", "events"],
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "intro": { "type": "string", "maxLength": 240 },
    "summary": { "type": "string", "maxLength": 300 },
    "unit": { "type": "string", "maxLength": 8 },
    "end": { "type": "number", "minimum": 1 },
    "step": { "type": "number", "minimum": 0 },
    "ticks": { "type": "integer", "minimum": 1, "maximum": 24 },
    "seconds": { "type": "number", "minimum": 2, "maximum": 30 },
    "lanes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "maxLength": 20 }, "label": { "type": "string", "maxLength": 16 } } } },
    "events": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "object", "additionalProperties": false, "required": ["lane", "start", "end"],
      "properties": { "lane": { "type": "string" }, "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 },
        "label": { "type": "string", "maxLength": 24 },
        "role": { "enum": ["process", "worker", "service", "gateway", "queue", "resource", "error", "secret", "datastore", "cache", "object", "client", "controller"] },
        "say": { "type": "string", "maxLength": 240 } } } },
    "marks": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["at"],
      "properties": { "at": { "type": "number", "minimum": 0 }, "label": { "type": "string", "maxLength": 20 }, "say": { "type": "string", "maxLength": 240 } } } }
  }
}
